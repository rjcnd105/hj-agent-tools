{
  "manifest_version": 3,
  "name": "ego-recorder",
  "version": "0.1.0",
  "description": "Record a login and payment session for automation.",
  "key": "",
  "permissions": ["debugger", "tabs", "nativeMessaging", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "ego-recorder" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
